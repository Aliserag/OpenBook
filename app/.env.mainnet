# Arc mainnet build (chain 5042). Committed on purpose: a judge can reproduce this exact
# bundle with `bunx vite build --mode mainnet`. Addresses are public chain state.
#   escrow       0x1D2FB397D890aDd415Dd99dFCD00699629D58a62   (ArcProxy over the EIP-8183 impl)
#   hook         0xe6Ac092054A17C43e206c8159BB8a9Bd67E97E9E   (SlaHook)
#   policy       0x651255FCc762A032237e8D14838bA9f18a7171af   (PolicyWallet)
VITE_ARC_CHAIN_ID=5042
VITE_ARC_CHAIN_NAME=Arc
VITE_ARC_EXPLORER=https://explorer.arc.io
VITE_ARC_TESTNET_RPC=https://rpc.mainnet.arc.io
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
VITE_ESCROW=0x1D2FB397D890aDd415Dd99dFCD00699629D58a62
VITE_HOOK=0xe6Ac092054A17C43e206c8159BB8a9Bd67E97E9E
VITE_POLICY_WALLET=0x651255FCc762A032237e8D14838bA9f18a7171af
VITE_OPERATOR_ADDRESS=0x64A78b6d5e99274d01D1d0A70B180A73AAEb8d21
# Circle's developer-controlled wallets are testnet entities: mainnet purchases sign with a
# connected wallet (or the demo key), so the console never reaches for a testnet signer.
VITE_BUY_LANE=wallet
# Same-origin: this deployment's own worker carries the mainnet chain env (set as preview
# variables on the host). Empty beats .env.local's production base here.
VITE_API_BASE=
