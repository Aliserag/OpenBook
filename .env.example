# Arc Testnet (chain 5042002)
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
ARC_TESTNET_PK=            # throwaway testnet key for the CLI paths (never the deployed app)
# OpenBook's ERC-8183 escrow instance (ArcProxy over Circle's reference implementation, 2% fee, SlaHook whitelisted)
ERC8183_ADDR=0x967e005154D0F62C33Eac8E2F44b44d4C4C07Dd5
OPENBOOK_ESCROW=0x967e005154D0F62C33Eac8E2F44b44d4C4C07Dd5
OPENBOOK_HOOK=0x606075F3Cf9b5B66E7e4DD2ea369894374Ff0846
# USDC ERC-20 on Arc testnet (6 decimals); native gas is 18 decimals on the same balance
USDC_ADDR=0x3600000000000000000000000000000000000000
POLICY_WALLET_ADDR=0x4e83eB15EE973A49E40D9A79aB2cA89a4Eb4894E
AGENT_ADDR=                # agent key address for the PolicyWallet constructor (withdrawal caller)

# The Graph
GRAPH_GATEWAY_KEY=         # Subgraph Studio API key: gateway queries, /api/deliver, the MCP query tools
GRAPH_STUDIO_DEPLOY_KEY=   # Studio deploy key for the open-book subgraph
SELLER_ADDRESS=            # the job provider the open-book subgraph books (deploy-subgraph.sh substitutes it)

# ENS (Sepolia, ENSv2)
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_PK=                # name owner (treasury EOA)
TREASURY_EOA=              # address of SEPOLIA_PK; derived from the key if empty
OPENBOOK_NAME=openbook.eth
ENS_COMMIT_SECRET=         # printed by scripts/ens/setup.sh stage 3; save it before the reveal
ENS_RESOLVER=              # predicted PermissionedResolver (printed by setup.sh stage 2); needed to resume --from 3+

# Attester and seller keys (server-side only; never shipped to the browser)
OPENBOOK_ATTESTER_PK=      # signs /api/deliver observations and settles jobs in /api/attest (the hook's attester)
OPERATOR_PRIVATE_KEY=      # MCP seller/operator key for query_dataset attestations and verify_delivery settle

# Circle developer-controlled wallets (the web app's buyer and seller; gas by Circle Gas Station)
CIRCLE_API_KEY=            # console.circle.com -> Keys
CIRCLE_ENTITY_SECRET=      # console.circle.com/wallets/dev/configurator/entity-secret (register it once)
CIRCLE_WALLET_SET_ID=      # optional: reuse an existing wallet set
CIRCLE_BUYER_WALLET_ID=
CIRCLE_BUYER_WALLET_ADDRESS=
CIRCLE_SELLER_WALLET_ID=
CIRCLE_SELLER_WALLET_ADDRESS=

# Console language model (server-side; any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731

# Agent identity
AGENT_ID=                  # ERC-8004 agent id after registration
AGENT_METADATA_URI=        # pinned ERC-8004 metadata JSON
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
